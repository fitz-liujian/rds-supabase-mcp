{
  "name": "rds-supabase-mcp",
  "version": "0.1.0",
  "description": "Full-featured management MCP server for cloud-hosted Supabase instances without direct database access",
  "main": "dist/index.js",
  "bin": {
    "rds-supabase-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --banner \"#!/usr/bin/env node\"",
    "start": "node dist/index.js",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "bunx tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "supabase",
    "rds",
    "postgres",
    "postgrest",
    "database",
    "model-context-protocol",
    "cloud-hosted"
  ],
  "author": "华为云开源开发者",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@supabase/supabase-js": "^2.90.1",
    "commander": "^14.0.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.17.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.7",
    "@types/pg": "^8.16.0",
    "typescript": "^5.9.3"
  }
}
